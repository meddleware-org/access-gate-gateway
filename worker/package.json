{
  "name": "@meddleware/access-gate-gateway-worker-harness",
  "version": "0.0.32",
  "private": true,
  "type": "module",
  "description": "Black-box test harness and deploy tooling for the Rust Worker (wrangler + workerd). Test code only: no Worker logic lives here.",
  "license": "0BSD",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretest": "node tests/prepare.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=600000 tests/*.test.mjs",
    "test:diff": "node tests/prepare.mjs && node --test --test-concurrency=1 --test-timeout=600000 tests/differential.diff.mjs"
  },
  "devDependencies": {
    "@meddleware/access-gate-gateway-client": "0.0.21",
    "@mysten/sui": "2.36.0",
    "esbuild": "0.28.2",
    "smol-toml": "1.9.1",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
