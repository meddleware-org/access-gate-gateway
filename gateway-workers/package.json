{
  "name": "@meddleware/access-gate-gateway",
  "version": "0.0.33",
  "type": "module",
  "description": "Cloudflare Workers implementation of the access-gate gateway: a wire-identical, drop-in sibling of the Rust gateway that gates any HTTP upstream behind an access_gate NFT.",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/access-gate-gateway.git",
    "directory": "gateway-workers"
  },
  "main": "src/index.ts",
  "files": [
    "src",
    "wrangler.toml",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project cloudflare-integration",
    "test:grpc": "GRPC_TESTNET=1 vitest run test/integration/grpc-chain.integration.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "sync:vectors": "node ../scripts/sync-vectors.mjs"
  },
  "dependencies": {
    "@meddleware/access-gate-client": "^0.0.12",
    "@meddleware/access-gate-gateway-client": "^0.0.21",
    "@mysten/sui": "^2.33.1",
    "@noble/curves": "~2.4.0",
    "@noble/hashes": "~2.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "~0.23.0",
    "@cloudflare/workers-types": "~5.20261027.1",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
