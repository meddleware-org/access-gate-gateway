-    while i + 5 <= body.len() {
-        let flag = body[i];
-        let len = u32::from_be_bytes([body[i + 1], body[i + 2], body[i + 3], body[i + 4]]) as usize;
-        i += 5;
-        let end = i
-            .checked_add(len)
-            .filter(|e| *e <= body.len())
