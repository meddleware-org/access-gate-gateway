-const VALUE_STRING: u32 = 3;
-const VALUE_BOOL: u32 = 4;
-const VALUE_STRUCT: u32 = 5;
-const VALUE_LIST: u32 = 6;
-const STRUCT_FIELDS: u32 = 1;
-const ENTRY_KEY: u32 = 1;
-const ENTRY_VALUE: u32 = 2;
-const LIST_VALUES: u32 = 1;
