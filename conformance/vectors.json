  "responses": {
    "description": "The gateways' answer for each outcome: HTTP status and the JSON body { error, code? } (`code` only on a 409 conflict). `statuses` is GATEWAY_STATUS, `conflictCodes` is GATEWAY_CONFLICT_CODES, and each case names an `outcome` every implementation must be able to produce and then answer exactly so. Upstream transport faults (413, 504, an upstream 502) are not listed: they depend on the upstream, not on the protocol.",
    "statuses": {
      "missingProof": 401,
      "denied": 403,
      "methodNotAllowed": 405,
      "conflict": 409,
      "bodyTooLarge": 413,
      "rateLimited": 429,
      "badGateway": 502,
      "stateUnavailable": 503,
      "gatewayTimeout": 504,
      "loopDetected": 508
    },
    "conflictCodes": [
      "redeemed",
      "leased"
    ],
    "cases": [
